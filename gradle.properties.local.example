# 本地调试剖面示例。复制为 gradle.properties.local（已被 .gitignore 忽略）后生效。
# 也可不复制文件，直接用命令行参数：
#   .\gradlew.bat -PcourseMindProfile=local -PlocalIdePath=D:\dev-software\idea-2026.2.0.1.win -PjavaVersion=25 buildPlugin
#
# 注意：剖面必须由 courseMindProfile 显式选择。用户级 GRADLE_USER_HOME/gradle.properties
# 里即便配置了 localIdePath，也不会自动切换剖面。

courseMindProfile=local
platformType=IU
localIdePath=D:\\dev-software\\idea-2026.2.0.1.win
javaVersion=25

# 若本机 JDK 25 未注册到 Gradle，把 IDEA 自带 JBR 加入 toolchain 探测路径（命令行同样适用）：
#   -Porg.gradle.java.installations.paths=D:\dev-software\idea-2026.2.0.1.win\jbr
